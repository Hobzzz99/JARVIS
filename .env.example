# ---------------------------------------------------------------------------
# JARVIS — environment configuration
# Copy to `.env` and fill in your own values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- LLM (Google Gemini) ---------------------------------------------------
# Free key: https://aistudio.google.com/app/apikey
# Leave empty to run JARVIS in offline mode (local HuggingFace models only).
GEMINI_API_KEY=
# `gemini-flash-latest` is an auto-updating alias, so the project keeps working
# when Google retires a specific version. Pin an exact id if you need stability.
GEMINI_MODEL=gemini-flash-latest

# --- News retrieval (NewsAPI) ----------------------------------------------
# Free key (100 requests/day): https://newsapi.org/register
# Leave empty to fall back to clearly-labelled offline sample articles.
NEWS_API_KEY=

# --- Local model routing ---------------------------------------------------
# HF_RANKING=true      -> rank articles with facebook/bart-large-mnli (local)
# HF_SUMMARIZER=true   -> summarise with facebook/bart-large-cnn instead of Gemini
HF_RANKING=true
HF_SUMMARIZER=false

# Preload HuggingFace models on API startup (slower boot, faster first request)
PRELOAD_MODELS=true

# --- Model identifiers (override to swap models without touching code) -----
HF_CLASSIFIER_MODEL=facebook/bart-large-mnli
HF_SUMMARIZER_MODEL=facebook/bart-large-cnn
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Retrieval tuning ------------------------------------------------------
MAX_NEWS_QUERIES=3
MAX_PAPER_QUERIES=2
NEWS_PAGE_SIZE=10
PAPERS_PER_QUERY=4
DEDUP_THRESHOLD=0.85
MAX_RANKED_ARTICLES=8

# --- API server ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
